---
import Layout from "../layouts/Layout.astro";
---

<Layout>
	<div class="page-container">
		<h1>Success!</h1>

		<div id="subscribe-success-content"></div>
	</div>
</Layout>

<script>
	// Success page for the email-first flow: the magic-link click has already
	// verified the email by the time a subscription happens, so there is no
	// verification step left to mention.
	interface SubscribeResult {
		statusMessage: string;
	}

	const content = document.getElementById("subscribe-success-content")!;

	const raw = sessionStorage.getItem("subscribeResult");
	sessionStorage.removeItem("subscribeResult");

	let result: SubscribeResult | null = null;
	try {
		result = raw ? (JSON.parse(raw) as SubscribeResult) : null;
	} catch {
		result = null;
	}

	if (!result) {
		content.innerHTML =
			'<p>An unexpected error occurred. Please <a href="/">go back and try again.</a></p>';
	} else {
		const paragraph = document.createElement("p");
		paragraph.textContent = result.statusMessage;
		content.appendChild(paragraph);

		const notifications = document.createElement("p");
		notifications.textContent =
			"We'll send new album notifications to your inbox. You can unsubscribe at any time via the links in those emails.";
		content.appendChild(notifications);

		const signInLink = document.createElement("p");
		signInLink.textContent =
			"Your sign-in link stays valid for 24 hours if you'd like to come back and add more.";
		content.appendChild(signInLink);
	}
</script>
