---
import Layout from "../layouts/Layout.astro";
---

<Layout>
	<div class="page-container">
		<h1>Search for artists</h1>

		<div id="subscribe-content">
			<div class="loading-spinner"></div>
		</div>
	</div>
</Layout>

<script>
	// Email-first flow. Step 1: the visitor enters their email and we send them
	// a magic link. Step 2: clicking the link validates the 24h access token
	// (and verifies their email - the link IS the verification), unlocking the
	// picker. Step 3: find artists (public playlist import and/or search),
	// select them, and subscribe. Every API call after the gate carries the
	// token; if it expires mid-session the gate returns (selections are kept).
	interface ArtistImage {
		url: string;
		width: number;
		height: number;
	}

	interface SpotifyArtistSummary {
		id: string;
		name: string;
		image: ArtistImage;
	}

	interface PlaylistImportResult {
		playlistName: string | null;
		tracksTotal: number | null;
		artists: SpotifyArtistSummary[];
	}

	interface ArtistState extends SpotifyArtistSummary {
		selected: boolean;
	}

	interface SubscribeResult {
		statusMessage: string;
		requiresEmailVerification: boolean;
	}

	const SEARCH_DEBOUNCE_MS = 400;
	const MIN_SEARCH_LENGTH = 2;
	const TOKEN_STORAGE_KEY = "subscribeAccessToken";

	const content = document.getElementById("subscribe-content")!;

	//Insertion-ordered by artist ID: playlist imports land first (most
	//frequently featured first), search adds are appended. Kept across
	//re-renders, so a token expiring mid-session doesn't lose selections
	const artists = new Map<string, ArtistState>();

	let accessToken: string | null = null;
	let signedInEmail: string | null = null;

	async function postJson<T>(url: string, body: unknown): Promise<T> {
		const response = await fetch(url, {
			method: "POST",
			headers: { "Content-Type": "application/json" },
			body: JSON.stringify(body),
		});
		const data = (await response.json().catch(() => null)) as
			| (T & { error?: string })
			| null;
		if (!response.ok || !data) {
			//Attach the status so callers can distinguish an expired token (401)
			throw Object.assign(
				new Error(
					data?.error ?? `Request failed with status ${response.status}`,
				),
				{ status: response.status },
			);
		}
		return data;
	}

	function isTokenRejected(e: unknown): boolean {
		return e instanceof Error && (e as Error & { status?: number }).status === 401;
	}

	function clearToken(): void {
		accessToken = null;
		signedInEmail = null;
		sessionStorage.removeItem(TOKEN_STORAGE_KEY);
	}

	/** Any 401 means the token expired mid-session: back to the email gate (selections are kept) */
	function handleExpiredToken(): void {
		clearToken();
		renderLocked(
			"Your sign-in link has expired. Enter your email address to get a new one.",
		);
	}

	function plural(
		count: number,
		singular: string,
		pluralForm = `${singular}s`,
	): string {
		return `${count} ${count === 1 ? singular : pluralForm}`;
	}

	/** Status lines are plain text (playlist names etc. come from Spotify) */
	function setStatus(
		elementId: string,
		message: string,
		isError: boolean,
	): void {
		const element = document.getElementById(elementId);
		if (!element) return;
		element.textContent = message;
		element.classList.toggle("error", isError);
		element.hidden = !message;
	}

	function numSelected(): number {
		let selected = 0;
		for (const artist of artists.values()) {
			if (artist.selected) selected++;
		}
		return selected;
	}

	// ---- Step 1: the email gate ----------------------------------------------

	function renderLocked(message: string | null): void {
		content.innerHTML = `
			<p class="m-b-40">
				First, enter your email address. We'll send you a sign-in link that verifies your email
				and keeps you signed in for 24 hours – no password needed.
			</p>

			<div class="form-group">
				<label class="control-label" for="email">Your email address</label>
				<input type="email" id="email" class="form-control" placeholder="name@example.com"
					spellcheck="false" autocomplete="off" />
			</div>
			<button type="button" class="btn btn-primary btn-lg" id="send-link">Email me a sign-in link</button>
			<div id="link-status" class="import-status m-t-10" hidden></div>`;

		if (message) {
			setStatus("link-status", message, true);
		}

		const input = document.getElementById("email")! as HTMLInputElement;
		const button = document.getElementById("send-link")! as HTMLButtonElement;
		button.addEventListener("click", () => void requestMagicLink());
		input.addEventListener("keydown", (event) => {
			if (event.key === "Enter") {
				event.preventDefault();
				void requestMagicLink();
			}
		});
		input.focus();
	}

	async function requestMagicLink(): Promise<void> {
		const input = document.getElementById("email")! as HTMLInputElement;
		const button = document.getElementById("send-link")! as HTMLButtonElement;
		const email = input.value.trim();

		if (!email) {
			setStatus("link-status", "Please enter your email address.", true);
			return;
		}

		button.disabled = true;
		setStatus("link-status", "Sending your sign-in link…", false);

		try {
			const data = await postJson<{ statusMessage: string }>(
				"/api/auth/request-magic-link",
				{
					emailAddress: email,
				},
			);
			renderCheckYourInbox(data.statusMessage);
		} catch (e) {
			setStatus(
				"link-status",
				e instanceof Error ? e.message : String(e),
				true,
			);
			button.disabled = false;
		}
	}

	function renderCheckYourInbox(statusMessage: string): void {
		content.innerHTML = `
			<p id="inbox-message" class="m-b-20"></p>
			<p class="m-b-20">
				Click the link in the email to continue – it also verifies your email address, so you won't
				need to do anything else.
			</p>
			<button type="button" class="btn btn-primary" id="back-to-email">Use a different email address</button>`;

		document.getElementById("inbox-message")!.textContent = statusMessage;
		document
			.getElementById("back-to-email")!
			.addEventListener("click", () => renderLocked(null));
	}

	// ---- Step 2: the magic-link click ----------------------------------------

	async function tryUnlock(token: string): Promise<void> {
		try {
			const data = await postJson<{ emailAddress: string }>(
				"/api/auth/validate",
				{ token },
			);
			accessToken = token;
			signedInEmail = data.emailAddress;
			sessionStorage.setItem(TOKEN_STORAGE_KEY, token);
			renderUnlocked();
		} catch {
			sessionStorage.removeItem(TOKEN_STORAGE_KEY);
			renderLocked(
				"Your sign-in link has expired or is invalid. Enter your email address to get a new one.",
			);
		}
	}

	// ---- Step 3: the picker --------------------------------------------------

	function renderUnlocked(): void {
		content.innerHTML = `
			<p class="signed-in-as m-b-40" id="signed-in-as"></p>

			<p>
				Paste a link to a public Spotify playlist to import its artists, and/or search for artists by
				name. (Private playlists and Spotify's own playlists like Today's Top Hits can't be imported.)
			</p>
			<p class="m-b-40">
				To get a playlist link, right-click on it -> "Share" -> "Copy link to playlist". Then paste it below.
			</p>

			<div class="form-group">
				<label class="control-label" for="playlist-input">Paste a public Spotify playlist link</label>
				<div class="playlist-import-row">
					<input type="text" id="playlist-input" class="form-control"
						placeholder="https://open.spotify.com/playlist/…" spellcheck="false" autocomplete="off" />
					<button type="button" class="btn btn-primary" id="import-playlist">Import</button>
				</div>
				<div id="playlist-status" class="import-status" hidden></div>
			</div>

			<div class="form-group">
				<label class="control-label" for="artist-search">Or search for artists</label>
				<input type="text" id="artist-search" class="form-control" placeholder="eg: Crowded House"
					spellcheck="false" autocomplete="off" />
				<div id="search-status" class="import-status" hidden></div>
			</div>

			<div id="search-results" class="search-results" hidden></div>

			<h1>Subscribe to artists</h1>
			<p id="selection-summary"></p>

			<div id="selection-controls" hidden>
				<button type="button" class="btn btn-primary m-b-20 m-r-10" id="select-all">Select All</button>
				<button type="button" class="btn btn-primary m-b-20" id="select-none">Select None</button>
			</div>

			<div class="sticky-artist-filter-container" id="filter-container" hidden>
				<div class="form-group m-b-10">
					<label class="control-label" for="artist-name-filter">Filter by name</label>
					<input type="text" id="artist-name-filter" class="form-control artist-filter-input"
						placeholder="eg: Crowded House" spellcheck="false" autocomplete="off" />
				</div>
			</div>

			<div class="followed-artists-list-container">
				<div class="followed-artists-list" id="artists-list"></div>
			</div>

			<div class="subscribe-form-container">
				<div class="form-col">
					<h3 id="subscribing-heading"></h3>

					<div id="subscribe-form-holder"></div>
				</div>
			</div>`;

		//"Signed in as name@example.com. Not you?" (text + link, so built via DOM)
		const signedIn = document.getElementById("signed-in-as")!;
		signedIn.textContent = `Signed in as ${signedInEmail}. `;
		const notYou = document.createElement("a");
		notYou.href = "#";
		notYou.textContent = "Not you?";
		notYou.addEventListener("click", (event) => {
			event.preventDefault();
			clearToken();
			renderLocked(null);
		});
		signedIn.appendChild(notYou);

		document
			.getElementById("import-playlist")!
			.addEventListener("click", () => void importPlaylist());

		const searchInput = document.getElementById(
			"artist-search",
		)! as HTMLInputElement;
		let searchTimer: ReturnType<typeof setTimeout> | undefined;
		searchInput.addEventListener("input", () => {
			clearTimeout(searchTimer);
			const query = searchInput.value.trim();
			if (query.length < MIN_SEARCH_LENGTH) {
				setStatus("search-status", "", false);
				renderSearchResults([]);
				return;
			}
			searchTimer = setTimeout(() => void runSearch(query), SEARCH_DEBOUNCE_MS);
		});

		document
			.getElementById("select-all")!
			.addEventListener("click", () => setSelectedAllArtists(true));
		document
			.getElementById("select-none")!
			.addEventListener("click", () => setSelectedAllArtists(false));

		const filterInput = document.getElementById(
			"artist-name-filter",
		)! as HTMLInputElement;
		filterInput.addEventListener("input", () =>
			renderArtistList(filterInput.value),
		);

		renderArtistList();
		renderSubscribeForm();
		updateSelectionUi();
	}

	async function importPlaylist(): Promise<void> {
		const input = document.getElementById(
			"playlist-input",
		)! as HTMLInputElement;
		const button = document.getElementById(
			"import-playlist",
		)! as HTMLButtonElement;
		const link = input.value.trim();

		if (!link) {
			setStatus("playlist-status", "Paste a playlist link first.", true);
			return;
		}

		button.disabled = true;
		setStatus(
			"playlist-status",
			"Importing artists from that playlist…",
			false,
		);

		try {
			const data = await postJson<PlaylistImportResult>(
				"/api/spotify/playlist-artists",
				{
					token: accessToken,
					playlist: link,
				},
			);

			let added = 0;
			let already = 0;
			for (const artist of data.artists) {
				if (artists.has(artist.id)) {
					already++;
					continue;
				}
				artists.set(artist.id, { ...artist, selected: true });
				added++;
			}

			if (added + already === 0) {
				setStatus(
					"playlist-status",
					"We couldn't find any artists in that playlist.",
					true,
				);
			} else {
				const fromName = data.playlistName
					? ` from “${data.playlistName}”`
					: "";
				const alreadyNote =
					already > 0
						? ` (${plural(already, "was", "were")} already in your list)`
						: "";
				setStatus(
					"playlist-status",
					`Imported ${plural(added, "artist")}${fromName}${alreadyNote}.`,
					false,
				);
				input.value = "";
			}

			renderArtistList();
			updateSelectionUi();
			updateSubscribeForm();
		} catch (e) {
			if (isTokenRejected(e)) {
				handleExpiredToken();
				return;
			}
			setStatus(
				"playlist-status",
				e instanceof Error ? e.message : String(e),
				true,
			);
		} finally {
			button.disabled = false;
		}
	}

	let searchSequence = 0;
	let lastSearchResults: SpotifyArtistSummary[] = [];

	async function runSearch(query: string): Promise<void> {
		//Ignore responses that a newer keystroke has superseded
		const sequence = ++searchSequence;
		setStatus("search-status", `Searching for “${query}”…`, false);

		try {
			const data = await postJson<{ artists: SpotifyArtistSummary[] }>(
				"/api/spotify/search-artists",
				{
					token: accessToken,
					query,
				},
			);
			if (sequence !== searchSequence) return;

			renderSearchResults(data.artists);
			setStatus(
				"search-status",
				data.artists.length === 0
					? "No artists found – try a different search."
					: "",
				false,
			);
		} catch (e) {
			if (sequence !== searchSequence) return;
			if (isTokenRejected(e)) {
				handleExpiredToken();
				return;
			}
			renderSearchResults([]);
			setStatus(
				"search-status",
				e instanceof Error ? e.message : String(e),
				true,
			);
		}
	}

	function renderSearchResults(results: SpotifyArtistSummary[]): void {
		lastSearchResults = results;

		const container = document.getElementById("search-results")!;
		container.textContent = "";
		container.hidden = results.length === 0;

		for (const result of results) {
			const added = artists.has(result.id);

			const tile = document.createElement("div");
			tile.className = `search-result${added ? " added" : ""}`;
			tile.addEventListener("click", () => addArtist(result));

			const image = document.createElement("img");
			image.className = "search-result-image";
			image.src = result.image.url;
			image.alt = result.name;
			image.loading = "lazy";

			const name = document.createElement("div");
			name.className = "search-result-name";
			name.textContent = result.name;
			//Long names ellipsize in the tile: keep the full name on hover
			name.title = result.name;

			const action = document.createElement("div");
			action.className = "search-result-action";
			//Just the check icon when added: the word overflows narrow tiles
			action.textContent = added ? "✓" : "Add";
			action.title = added ? "Added" : "";

			tile.appendChild(image);
			tile.appendChild(name);
			tile.appendChild(action);
			container.appendChild(tile);
		}
	}

	function addArtist(artist: SpotifyArtistSummary): void {
		if (artists.has(artist.id)) return;

		artists.set(artist.id, { ...artist, selected: true });

		renderArtistList();
		updateSelectionUi();
		updateSubscribeForm();
		renderSearchResults(lastSearchResults);
	}

	function renderArtistList(filter: string = ""): void {
		const list = document.getElementById("artists-list")!;
		list.textContent = "";

		//When empty, render nothing here: the selection summary already shows
		//the "No artists yet" hint, and repeating it just looks broken
		if (artists.size === 0) return;

		const filterLower = filter.trim().toLowerCase();

		for (const artist of artists.values()) {
			if (filterLower && !artist.name.toLowerCase().includes(filterLower))
				continue;

			const container = document.createElement("div");
			container.className = `artist-container${artist.selected ? " selected" : ""}`;
			container.addEventListener("click", () => {
				artist.selected = !artist.selected;
				container.className = `artist-container${artist.selected ? " selected" : ""}`;
				updateSelectionUi();
				updateSubscribeForm();
			});

			const square = document.createElement("div");
			square.className = "square";

			const image = document.createElement("img");
			image.className = "artist-image";
			image.src = artist.image.url;
			image.alt = artist.name;
			image.loading = "lazy";
			square.appendChild(image);

			const name = document.createElement("div");
			name.className = "artist-name";
			name.textContent = artist.name;

			container.appendChild(square);
			container.appendChild(name);
			list.appendChild(container);
		}
	}

	function setSelectedAllArtists(selected: boolean): void {
		if (selected) {
			const filterInput = document.getElementById(
				"artist-name-filter",
			) as HTMLInputElement | null;
			if (filterInput) {
				filterInput.value = "";
			}
		}
		for (const artist of artists.values()) {
			artist.selected = selected;
		}
		renderArtistList();
		updateSelectionUi();
		updateSubscribeForm();
	}

	function updateSelectionUi(): void {
		const summary = document.getElementById("selection-summary");
		const controls = document.getElementById("selection-controls");
		const filterContainer = document.getElementById("filter-container");
		const hasArtists = artists.size > 0;

		if (summary) {
			summary.textContent = hasArtists
				? `${plural(artists.size, "artist")} in your list, ${numSelected()} selected. Tap or click artists to toggle selection.`
				: "No artists yet – import a playlist or search above to get started.";
		}
		if (controls) {
			controls.hidden = !hasArtists;
		}
		if (filterContainer) {
			filterContainer.hidden = !hasArtists;
		}
	}

	function renderSubscribeForm(): void {
		const holder = document.getElementById("subscribe-form-holder")!;
		//No email input: the server resolves the (already verified) subscriber
		//from the magic-link token
		holder.innerHTML = `
			<form id="subscribe-form">
				<button type="submit" class="btn btn-primary btn-lg" id="subscribe-button">Subscribe</button>
			</form>`;

		const form = document.getElementById("subscribe-form")!;
		form.addEventListener("submit", (event) => {
			event.preventDefault();
			void handleSubmit();
		});

		updateSubscribeForm();
	}

	function updateSubscribeForm(): void {
		const heading = document.getElementById("subscribing-heading");
		const button = document.getElementById(
			"subscribe-button",
		) as HTMLButtonElement | null;
		const selected = numSelected();

		if (heading) {
			heading.textContent = `Subscribing to ${selected} artist${selected === 1 ? "" : "s"}`;
		}
		if (button) {
			button.disabled = selected === 0;
		}
	}

	async function handleSubmit(): Promise<void> {
		const holder = document.getElementById("subscribe-form-holder")!;

		holder.innerHTML = '<div class="loading-spinner"></div>';

		try {
			const result = await postJson<SubscribeResult>(
				"/api/subscriptions/subscribe",
				{
					token: accessToken,
					artists: [...artists.values()]
						.filter((artist) => artist.selected)
						.map((artist) => ({ spotifyId: artist.id, name: artist.name })),
				},
			);

			sessionStorage.setItem("subscribeResult", JSON.stringify(result));
			window.location.replace("/subscribe-success");
		} catch (e) {
			if (isTokenRejected(e)) {
				handleExpiredToken();
				return;
			}
			holder.innerHTML = "";
			const error = document.createElement("div");
			error.className = "error-message";
			error.textContent = e instanceof Error ? e.message : String(e);
			holder.appendChild(error);

			const button = document.createElement("button");
			button.type = "button";
			button.className = "btn btn-primary btn-lg m-t-20";
			button.textContent = "Try again";
			button.addEventListener("click", () => {
				renderSubscribeForm();
			});
			holder.appendChild(button);
		}
	}

	// ---- Entry point ---------------------------------------------------------

	async function init(): Promise<void> {
		//A token in the URL is the magic-link click: consume it, then strip it
		//from the address bar (it's a credential)
		const urlToken = new URLSearchParams(window.location.search).get(
			"token",
		);
		if (urlToken) {
			window.history.replaceState({}, "", window.location.pathname);
			await tryUnlock(urlToken);
			return;
		}

		const storedToken = sessionStorage.getItem(TOKEN_STORAGE_KEY);
		if (storedToken) {
			await tryUnlock(storedToken);
			return;
		}

		renderLocked(null);
	}

	void init();
</script>
