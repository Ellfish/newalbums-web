---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<div class="page-container">
		<h1 id="heading">Spotify</h1>
		<div id="content">
			<div class="loading-spinner"></div>
		</div>
	</div>
</Layout>

<script>
	// Ported from SpotifyCallback.js, upgraded from the (now removed) implicit
	// grant to Authorization Code + PKCE: exchanges the code query param for an
	// access token, validating state. The token is held in sessionStorage for
	// the remainder of the flow only.
	import { exchangeCodeForToken, storeAccessToken } from '../lib/spotify-auth';

	function escapeHtml(value: string): string {
		return value
			.replaceAll('&', '&amp;')
			.replaceAll('<', '&lt;')
			.replaceAll('>', '&gt;')
			.replaceAll('"', '&quot;')
			.replaceAll("'", '&#039;');
	}

	const searchValues = new URLSearchParams(window.location.search);
	const error = searchValues.get('error');

	const heading = document.getElementById('heading')!;
	const content = document.getElementById('content')!;

	if (error) {
		heading.textContent = 'Cancelled';
		content.innerHTML =
			'<p>You must authorise access to your Spotify account so we can read your followed artists. <a href="/">Go back and try again.</a></p>';
	} else {
		try {
			const accessToken = await exchangeCodeForToken(searchValues);
			storeAccessToken(accessToken);
			window.location.replace('/subscribe-to-artists');
		} catch (e) {
			const message = e instanceof Error ? e.message : String(e);
			heading.textContent = 'Error';
			content.innerHTML = `<p>${escapeHtml(message)}</p><p>Please <a href="/">go back and try again.</a></p>`;
		}
	}
</script>
