{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-09-26",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "newalbums-web",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "newalbums",
			"database_id": "1aed5f42-6705-447c-8b04-378d0f355c38"
		}
	],
	// Non-secret app config (secrets live in `wrangler secret put` / .dev.vars)
	"vars": {
		"APP_NAME": "New Albums via Email",
		"FRONTEND_ROOT_URL": "https://newalbumsviaemail.com",
		"SYSTEM_EMAIL_ADDRESS": "noreply@newalbumsviaemail.com",
		"ADMIN_EMAIL_ADDRESS": "ellfish@gmail.com",
		"ADMIN_FULL_NAME": "Elliot Fisher",
		"MAILGUN_API_URL": "https://api.mailgun.net/v3/",
		"MAILGUN_DOMAIN": "newalbumsviaemail.com"
	},
	// Staging deployment (built + deployed with CLOUDFLARE_ENV=staging): same
	// code, staging worker name, staging D1, and root URL for email links
	"env": {
		"staging": {
			"name": "newalbums-web-staging",
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "newalbums-staging",
					"database_id": "3f38c094-c34e-4813-88e3-9161625d33eb"
				}
			],
			"vars": {
				"APP_NAME": "New Albums via Email",
				"FRONTEND_ROOT_URL": "https://newalbums-web-staging.ellfish.workers.dev",
				"SYSTEM_EMAIL_ADDRESS": "noreply@newalbumsviaemail.com",
				"ADMIN_EMAIL_ADDRESS": "ellfish@gmail.com",
				"ADMIN_FULL_NAME": "Elliot Fisher",
				"MAILGUN_API_URL": "https://api.mailgun.net/v3/",
				"MAILGUN_DOMAIN": "newalbumsviaemail.com"
			}
		}
	},
	"observability": {
		"enabled": true
	}
}